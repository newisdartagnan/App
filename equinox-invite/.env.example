# ══════════════════════════════════════════════════════════════
#  Front-end (Vite) — préfixe VITE_, exposé au navigateur
# ══════════════════════════════════════════════════════════════
# Laisser vide pour tourner en mode démo (données d'exemple, sans backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ══════════════════════════════════════════════════════════════
#  Edge Functions — secrets serveur (supabase secrets set …)
#  JAMAIS de préfixe VITE_ ici : rien de tout ceci ne doit
#  atteindre le navigateur.
# ══════════════════════════════════════════════════════════════

# --- Général ---
# URL publique du front (cible de redirection + liens WhatsApp)
APP_URL=http://localhost:5173
# Image d'aperçu Open Graph, 1200x630 recommandé
OG_IMAGE_URL=
# Origine autorisée pour le CORS des fonctions appelées par le navigateur
ALLOWED_ORIGIN=*
# Secret protégeant l'envoi en masse (en-tête x-admin-secret)
ADMIN_SECRET=

# --- Assistant (Claude) ---
# Sans clé, l'assistant bascule sur ses réponses de repli locales.
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
# Identifiant du numéro expéditeur (Meta Business > WhatsApp > API Setup)
WA_PHONE_NUMBER_ID=
# Token d'accès permanent de l'app Meta
WA_ACCESS_TOKEN=
# App Secret : sert à vérifier la signature HMAC des webhooks entrants
WA_APP_SECRET=
# Chaîne de votre choix, à recopier dans la config du webhook Meta
WA_VERIFY_TOKEN=
# Template approuvé par Meta pour initier la conversation
# Variables attendues : {{1}} = nom de l'invité, {{2}} = lien personnalisé
WA_TEMPLATE_NAME=invitation_equinoxe
WA_TEMPLATE_LANG=fr
WA_GRAPH_VERSION=v21.0
