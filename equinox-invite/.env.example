# ── Front-end (Vite) ─────────────────────────────────────────────
# Laisser vide pour tourner en mode démo (données d'exemple, sans backend).
# Renseigner pour brancher un vrai projet Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Edge Function (Supabase, injectées automatiquement en prod) ───
# En local (supabase functions serve), fournir au moins :
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY sont fournis par la plateforme.
# URL publique du front, utilisée comme cible de redirection par défaut :
APP_URL=http://localhost:5173
# Image d'aperçu Open Graph (1200x630 recommandé) :
OG_IMAGE_URL=
