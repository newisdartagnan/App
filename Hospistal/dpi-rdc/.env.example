APP_NAME="DPI-RDC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL — obligatoire en production
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dpi_HGR_KINSHASA_01
DB_USERNAME=dpi_user
DB_PASSWORD=changeme

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Configuration établissement (multi-tenant Docker)
ESTABLISHMENT_CODE=HGR_KINSHASA_01
ESTABLISHMENT_NAME="Hôpital Général de Kinshasa"
CENTRAL_API_URL=https://central.dpi-rdc.local
CENTRAL_SYNC_TOKEN=
CENTRAL_HOST=central.dpi-rdc.local
CENTRAL_USER=backup
CENTRAL_GPG_KEY=central@dpi-rdc.local

# Ports publies sur la machine hote. Ne mettez PAS 80 ni 443 sous Windows :
# ces plages sont reservees par Hyper-V/WinNAT et le demarrage echoue avec
# « bind: An attempt was made to access a socket in a way forbidden by its
# access permissions ». Les anciennes variables APP_PORT / APP_SSL_PORT ne
# sont plus lues.
DPI_HTTP_PORT=8080
DPI_HTTPS_PORT=8443

# Base de donnees : deux usages possibles.
#
# 1) Par defaut, l'application utilise le PostgreSQL du conteneur. Celui-ci
#    est publie sur le poste au port ci-dessous (5433 et non 5432, pour ne
#    pas entrer en conflit avec un PostgreSQL deja installe sous Windows).
#    pgAdmin / DBeaver se connectent alors a localhost:5433, utilisateur
#    dpi_user, base dpi_<ESTABLISHMENT_CODE>.
DPI_DB_PORT=5433

# 2) Ou bien l'application utilise le PostgreSQL installe sur le poste.
#    Mettre DPI_DB_HOST=host.docker.internal et DPI_DB_PORT_APP=5432, puis
#    demarrer avec la surcouche :
#      docker compose -f docker-compose.yml -f docker-compose.pg-hote.yml up -d
#    Voir les instructions en tete de docker-compose.pg-hote.yml.
DPI_DB_HOST=db
DPI_DB_PORT_APP=5432

# Taux de change de depart. Ils sont ensuite revisables depuis l'ecran
# Parametrage, et la valeur saisie en base l'emporte sur celle-ci.
DPI_TAUX_USD_CDF=2300
DPI_TAUX_EUR_CDF=2681.50

VITE_APP_NAME="${APP_NAME}"
