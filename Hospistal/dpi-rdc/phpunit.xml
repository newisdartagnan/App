<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Valeurs de test FORCÉES : dans un conteneur, le .env et la section
             environment de docker-compose deviennent de vraies variables
             d'environnement, que des <env> non forcés ne remplacent pas. Sans
             force, les tests tourneraient avec APP_ENV=local, le cache et la
             file Redis, le courrier réel... et sur la base de l'hôpital.
             Laravel lit $_SERVER avant $_ENV : chaque valeur l'est donc aussi
             en <server>.

             Les migrations sont écrites pour PostgreSQL (SQLite ne sait pas
             les jouer) et les tests vident la base à chaque passage
             (RefreshDatabase) : la base est forcée sur dpi_test, et
             tests/TestCase.php refuse toute base dont le nom ne finit pas par
             _test. Voir « Lancer les tests » dans le README. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="dpi_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="dpi_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- Hôte et port restent surchargeables par l'environnement : dans le
             service docker « tests », le conteneur db ; sur le poste, par
             défaut, ce même conteneur publié sur localhost:5433. Utilisateur et
             mot de passe : ceux du .env. -->
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
    </php>
</phpunit>
