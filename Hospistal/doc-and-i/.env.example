APP_NAME="MediHome"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8097

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL du conteneur db (docker-compose.yml). Depuis le poste (pgAdmin,
# DBeaver) : localhost:5437.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=doc_and_i
DB_USERNAME=doc_and_i
DB_PASSWORD=changeme

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true dès que l'application est servie en HTTPS (production).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Envoi des SMS : « log » écrit le message dans storage/logs (développement).
# Un fournisseur réel sera branché ici avant le pilote.
SMS_DRIVER=log

# Paiement (PAY-02 à PAY-04) : « simulation » ne débite rien, refusée en
# production. Le pilote de l'agrégateur choisi par le client viendra ici.
PAIEMENT_FOURNISSEUR=simulation
# Secret des rappels signés de l'agrégateur (32 caractères au moins). Vide :
# généré au premier démarrage du conteneur. Jamais dans Git.
PAIEMENT_SECRET_RAPPEL=
# Clé du sceau des notes et ordonnances signées (32 caractères au moins).
# Vide : générée au premier démarrage du conteneur. Ne jamais la changer
# ensuite (les documents signés deviendraient « altérés »). Jamais dans Git.
DOSSIER_SECRET_SIGNATURE=
# Commission de la plateforme sur les honoraires (PAY-09), en pourcentage.
# Valeur de démonstration : à fixer par le client.
DOC_AND_I_COMMISSION_POURCENT=20

# Version des conditions de téléconsultation et de traitement des données.
# La changer oblige chaque patient à les accepter de nouveau.
DOC_AND_I_CONSENTEMENT_VERSION=2026-11

# Établissement et numéro affichés quand le tri trouve un signe d'urgence
# (fournis par le client ; vides = « l'hôpital le plus proche »).
DOC_AND_I_URGENCES_ETABLISSEMENT=
DOC_AND_I_URGENCES_TELEPHONE=

VITE_APP_NAME="${APP_NAME}"
